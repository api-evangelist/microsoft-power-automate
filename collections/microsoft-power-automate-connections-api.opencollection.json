{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Power Automate Management Connections API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/authorize",
      "accessTokenUrl": "https://login.microsoftonline.com/common/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Connections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Microsoft Power Automate List Connections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.flow.microsoft.com/providers/Microsoft.ProcessSimple/environments/:environmentName/connections",
            "params": [
              {
                "name": "environmentName",
                "value": "",
                "type": "path",
                "description": "The name of the environment."
              }
            ]
          },
          "docs": "List all connections available in the given environment."
        }
      ]
    }
  ],
  "bundled": true
}