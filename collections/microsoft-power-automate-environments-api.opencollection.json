{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Power Automate Management Connections Environments API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/authorize",
      "accessTokenUrl": "https://login.microsoftonline.com/common/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Environments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Microsoft Power Automate List Environments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.flow.microsoft.com/providers/Microsoft.ProcessSimple/environments"
          },
          "docs": "List all the environments the current user has access to."
        }
      ]
    }
  ],
  "bundled": true
}